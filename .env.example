# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres + pgvector (docker compose up -d db)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contract_agent

# LLM: OpenAI is required for embeddings. Add ANTHROPIC_API_KEY to switch chat/drafting to Claude.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
# OPENAI_FAST_MODEL=gpt-4.1-mini
# OPENAI_MAIN_MODEL=gpt-4.1
# OPENAI_DRAFT_MODEL=gpt-5.5
# OPENAI_REVIEW_MODEL=gpt-5.5

# Google Drive (read-only service account). Path to the JSON file, or the JSON itself.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=service_account.json
# Folder id of MITVE TOOLS/NECHASIM/CONTRACTS. If empty, the folder is found by path.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_PATH=MITVE TOOLS/NECHASIM/CONTRACTS

# Optional: better web search than the free DuckDuckGo default
TAVILY_API_KEY=

# Cost guard: total tokens per rolling 24 hours
DAILY_TOKEN_BUDGET=2000000

# Backend access key (the frontend proxy sends it). Empty = open, fine for local only.
API_KEY=

# Run the nightly sync inside the API process (local use; Render uses a Cron Job)
ENABLE_SCHEDULER=false
